  "devDependencies": {
    "@electron/asar": "^4.3.1",
    "@electron/packager": "^20.3.0",
    "acorn": "^8.19.0",
    "acorn-walk": "^8.3.5",
    "electron": "44.9.1",
    "electron-builder": "26.15.3",
    "playwright": "1.51.1"
